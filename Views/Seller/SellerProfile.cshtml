@model Cloud_Kitchen_web_App.Models.SellerProfileViewModel
@{
    ViewData["Title"] = "Seller Profile";
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
}
<main class="main-content">
    <div class="profile-header">
        <div class="avatar card"><img id="avatarImg" src="images/profile.png" alt="avatar" /></div>
        <div class="profile-info">
            <h2 id="profileName">Amna Ramzan</h2>
            <div class="small" id="profileShop">Amna's Kitchen • Seller</div>
            <div class="small" id="profilePhone">0300-0000000</div>
            <div style="margin-top:8px"><button id="btnEdit" class="btn btn-edit">Edit Profile</button></div>
        </div>
    </div>

    <div class="card">
        <h3 style="margin-bottom:10px;color:var(--dark-brown)">Profile Details</h3>
        <div id="profileView">
            <div class="form-row"><div class="col"><label>Full name</label><div id="viewName"></div></div><div class="col"><label>Shop name</label><div id="viewShop"></div></div></div>
            <div class="form-row"><div class="col"><label>Phone</label><div id="viewPhone"></div></div><div class="col"><label>Email</label><div id="viewEmail"></div></div></div>
            <div style="margin-top:12px"><label>Address</label><div id="viewAddress"></div></div>
        </div>

        <form id="profileForm" style="display:none;margin-top:8px">
            <div class="form-row"><div class="col"><label>Full name</label><input id="inputName" type="text" /></div><div class="col"><label>Shop name</label><input id="inputShop" type="text" /></div></div>
            <div class="form-row"><div class="col"><label>Phone</label><input id="inputPhone" type="tel" /></div><div class="col"><label>Email</label><input id="inputEmail" type="email" /></div></div>
            <div style="margin-top:8px"><label>Address</label><textarea id="inputAddress"></textarea></div>
            <div style="margin-top:12px" class="photo-input"><div><label>Profile photo</label><input id="inputPhoto" type="file" accept="image/*" /></div><img id="photoPreview" class="img-preview" src="images/profile.png" alt="preview" /></div>
            <div class="actions"><button type="button" id="saveProfile" class="btn btn-save">Save</button><button type="button" id="cancelEdit" class="btn btn-cancel">Cancel</button></div>
        </form>
    </div>

</main>
